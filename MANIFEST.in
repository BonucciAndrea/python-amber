# Source distribution contents.
#
# The sdist on PyPI builds the engine itself: scripts/vendor_engine.sh copies
# the engine's C sources, build script and .k standard library into
# vendor/amber before `python -m build --sdist`, and setup.py builds
# libamber from there. No binary is ever shipped in an sdist -- a library built
# on the packager's machine is exactly what an sdist must not hold.
include README.md
include CHANGELOG.md
include LICENSE
include NOTICE
include pyproject.toml
include setup.py
include include/amber_capi.h
include src/py_amber.c
recursive-include src/amber *.py *.pyi py.typed
recursive-include tests *.py
recursive-include examples *.py
recursive-include scripts *.sh
include vendor/amber/build.sh vendor/amber/*.k vendor/amber/LICENSE vendor/amber/NOTICE vendor/amber/ENGINE_VERSION
recursive-include vendor/amber/src *.c *.h *.map
global-exclude *.so *.dylib *.dll *.o *.pyc __pycache__/*
prune build
prune dist
prune vendor/amber/o
