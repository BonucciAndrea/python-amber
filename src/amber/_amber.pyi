"""Type stubs for the C extension. The friendly API is in amber/__init__.py."""
from typing import Any, Callable, Iterable

class AmberError(Exception): ...

class Value:
    """An owned reference to a value inside the engine. Supports the buffer
    protocol (read-only) for vectors, len(), pickling and repr."""
    def type(self) -> int: ...
    def type_name(self) -> str: ...
    def count(self) -> int: ...
    def is_table(self) -> bool: ...
    def is_dict(self) -> bool: ...
    def is_atom(self) -> bool: ...
    def handle(self) -> int: ...
    def release(self) -> None: ...
    def is_released(self) -> bool: ...
    def flatten(self) -> Value: ...
    def format(self, plain: bool = ...) -> str: ...
    def to_str(self) -> str: ...
    def to_symbols(self) -> list[str]: ...
    def symbol_codes(self) -> tuple[bytes, list[str]]: ...
    def scalar(self) -> Any: ...
    def ncols(self) -> int: ...
    def colname(self, i: int) -> str: ...
    def column(self, i: int) -> Value: ...
    def keys(self) -> Value: ...
    def values(self) -> Value: ...
    def items(self) -> list[Value]: ...
    def equals(self, other: Value) -> bool: ...
    def to_bytes(self) -> bytes: ...
    def __len__(self) -> int: ...
    def __buffer__(self, flags: int) -> memoryview: ...

